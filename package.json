{
  "name": "@souped-tools/auth-nextjs",
  "version": "0.4.0",
  "description": "Souped OAuth integration for Next.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Souped-Tools/auth-nextjs.git"
  },
  "homepage": "https://github.com/Souped-Tools/auth-nextjs#readme",
  "bugs": {
    "url": "https://github.com/Souped-Tools/auth-nextjs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers.d.ts",
      "default": "./dist/handlers.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "next": "16.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5"
  },
  "license": "MIT"
}
